<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test code may use reflection-based STJ. Only the library is held to AOT rules. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="LateApexEarlySpeed.Json.Schema" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JsonSchemaObjectModel\JsonSchemaObjectModel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The suite keeps the tests for all drafts in one tree. TestSuite.cs selects the 2020-12 cases. Proposals are not part of a release. -->
    <Content Include="..\JSON-Schema-Test-Suite\validation\tests\**\*.json" Exclude="..\JSON-Schema-Test-Suite\validation\tests\proposals\**" LinkBase="TestSuite\validation" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
